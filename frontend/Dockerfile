FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8081
ARG NEXT_PUBLIC_PLAYER_SERVICE_URL=http://localhost:8082
ARG NEXT_PUBLIC_GAME_SERVICE_URL=http://localhost:8083
ARG NEXT_PUBLIC_MATCHMAKING_SERVICE_URL=http://localhost:8084
ARG NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8085/ws
ARG NEXT_PUBLIC_ANALYSIS_SERVICE_URL=http://localhost:8080

ENV NEXT_PUBLIC_AUTH_SERVICE_URL=$NEXT_PUBLIC_AUTH_SERVICE_URL
ENV NEXT_PUBLIC_PLAYER_SERVICE_URL=$NEXT_PUBLIC_PLAYER_SERVICE_URL
ENV NEXT_PUBLIC_GAME_SERVICE_URL=$NEXT_PUBLIC_GAME_SERVICE_URL
ENV NEXT_PUBLIC_MATCHMAKING_SERVICE_URL=$NEXT_PUBLIC_MATCHMAKING_SERVICE_URL
ENV NEXT_PUBLIC_WEBSOCKET_URL=$NEXT_PUBLIC_WEBSOCKET_URL
ENV NEXT_PUBLIC_ANALYSIS_SERVICE_URL=$NEXT_PUBLIC_ANALYSIS_SERVICE_URL

ENV NEXT_TELEMETRY_DISABLED 1

RUN npm run build

FROM node:18-alpine AS runner

WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["npm", "start"]
